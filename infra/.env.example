# Copy to infra/.env (git-ignored) and adjust.
PERFLAB_DATA_DIR=/Users/you/perflab-data
PERFLAB_DB_USER=perflab
PERFLAB_DB_PASSWORD=change-me
PERFLAB_DB_NAME=perflab
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Password of the read-only DB user grafana_ro. Used by the runner (Flyway placeholder
# when connecting) and by the Grafana datasource provisioning. Default: grafana-ro.
# The runner process must see the SAME value (ops/install-launchd.sh exports it from this
# file). Write it unquoted, without single quotes or whitespace.
PERFLAB_GRAFANA_RO_PASSWORD=grafana-ro
